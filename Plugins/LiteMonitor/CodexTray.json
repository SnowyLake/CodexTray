{
  "id": "CodexTray",
  "meta": {
    "name": "CodexTray",
    "version": "4.0.0",
    "author": "SnowyLake",
    "description": "显示 Codex Session, Codex Weekly 和 Cursor Monthly 的剩余百分比与重置时间"
  },
  "inputs": [
    {
      "key": "bridge_url",
      "label": "桥接服务地址",
      "type": "text",
      "default": "http://127.0.0.1:17890/codex-tray",
      "placeholder": "http://127.0.0.1:17890/codex-tray",
      "scope": "global"
    }
  ],
  "execution": {
    "type": "chain",
    "interval": 10,
    "steps": [
      {
        "id": "fetch_codex_tray",
        "url": "{{bridge_url}}",
        "method": "GET",
        "response_format": "json",
        "extract": {
          "codex_session_display": "display.session",
          "codex_weekly_display": "display.weekly",
          "cursor_monthly_display": "display.cursor_monthly",
          "codex_session_remaining": "limits.session.remaining_percent",
          "codex_weekly_remaining": "limits.weekly.remaining_percent",
          "cursor_monthly_remaining": "limits.cursor_monthly.remaining_percent"
        },
        "process": [
          {
            "var": "codex_session_color",
            "source": "codex_session_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          },
          {
            "var": "codex_weekly_color",
            "source": "codex_weekly_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          },
          {
            "var": "cursor_monthly_color",
            "source": "cursor_monthly_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          }
        ]
      }
    ]
  },
  "outputs": [
    {
      "key": "codex_session",
      "label": "Codex Session",
      "short_label": "Codex-Session",
      "format_val": "{{codex_session_display}}",
      "unit": "",
      "color": "{{codex_session_color}}"
    },
    {
      "key": "codex_weekly",
      "label": "Codex Weekly",
      "short_label": "Codex-Weekly",
      "format_val": "{{codex_weekly_display}}",
      "unit": "",
      "color": "{{codex_weekly_color}}"
    },
    {
      "key": "cursor_monthly",
      "label": "Cursor Monthly",
      "short_label": "Cursor-Monthly",
      "format_val": "{{cursor_monthly_display}}",
      "unit": "",
      "color": "{{cursor_monthly_color}}"
    }
  ]
}
