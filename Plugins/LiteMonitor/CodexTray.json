{
  "id": "CodexTray",
  "meta": {
    "name": "CodexTray",
    "version": "4.0.0",
    "author": "SnowyLake",
    "description": "显示 Codex, Cursor 和 Grok 的剩余额度百分比"
  },
  "inputs": [
    {
      "key": "bridge_url",
      "label": "桥接服务地址",
      "type": "text",
      "default": "http://127.0.0.1:17890/codex-tray",
      "placeholder": "http://127.0.0.1:17890/codex-tray",
      "scope": "global"
    }
  ],
  "execution": {
    "type": "chain",
    "interval": 10,
    "steps": [
      {
        "id": "fetch_codex_tray",
        "url": "{{bridge_url}}",
        "method": "GET",
        "response_format": "json",
        "extract": {
          "codex_display": "display.weekly",
          "cursor_display": "display.cursor_monthly",
          "grok_display": "display.grok_weekly",
          "codex_remaining": "limits.weekly.remaining_percent",
          "cursor_remaining": "limits.cursor_monthly.remaining_percent",
          "grok_remaining": "limits.grok_weekly.remaining_percent"
        },
        "process": [
          {
            "var": "codex_color",
            "source": "codex_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          },
          {
            "var": "cursor_color",
            "source": "cursor_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          },
          {
            "var": "grok_color",
            "source": "grok_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          }
        ]
      }
    ]
  },
  "outputs": [
    {
      "key": "codex",
      "label": "Codex",
      "short_label": "Codex",
      "format_val": "{{codex_display}}",
      "unit": "",
      "color": "{{codex_color}}"
    },
    {
      "key": "cursor",
      "label": "Cursor",
      "short_label": "Cursor",
      "format_val": "{{cursor_display}}",
      "unit": "",
      "color": "{{cursor_color}}"
    },
    {
      "key": "grok",
      "label": "Grok",
      "short_label": "Grok",
      "format_val": "{{grok_display}}",
      "unit": "",
      "color": "{{grok_color}}"
    }
  ]
}
