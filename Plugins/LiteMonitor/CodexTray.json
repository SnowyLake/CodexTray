{
  "id": "CodexTray",
  "meta": {
    "name": "CodexTray",
    "version": "6.5.0",
    "author": "SnowyLake",
    "description": "显示 Codex, Grok, Gemini 和 OpenCode 的剩余额度百分比"
  },
  "inputs": [
    {
      "key": "bridge_url",
      "label": "桥接服务地址",
      "type": "text",
      "default": "http://127.0.0.1:17890/codex-tray",
      "placeholder": "http://127.0.0.1:17890/codex-tray",
      "scope": "global"
    }
  ],
  "execution": {
    "type": "chain",
    "interval": 10,
    "steps": [
      {
        "id": "fetch_codex_tray",
        "url": "{{bridge_url}}",
        "method": "GET",
        "response_format": "json",
        "extract": {
          "codex_display": "display.codex_weekly",
          "grok_display": "display.grok_weekly",
          "gemini_display": "display.gemini_session",
          "opencode_display": "display.opencode_session",
          "codex_remaining": "limits.codex_weekly.remaining_percent",
          "grok_remaining": "limits.grok_weekly.remaining_percent",
          "gemini_remaining": "limits.gemini_session.remaining_percent",
          "opencode_remaining": "limits.opencode_session.remaining_percent"
        },
        "process": [
          {
            "var": "codex_color",
            "source": "codex_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          },
          {
            "var": "grok_color",
            "source": "grok_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          },
          {
            "var": "gemini_color",
            "source": "gemini_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          },
          {
            "var": "opencode_color",
            "source": "opencode_remaining",
            "function": "threshold_switch",
            "value_map": {
              "0": "2",
              "20": "1",
              "50": "0"
            }
          }
        ]
      }
    ]
  },
  "outputs": [
    {
      "key": "codex",
      "label": "Codex",
      "short_label": "Codex",
      "format_val": "{{codex_display}}",
      "unit": "",
      "color": "{{codex_color}}"
    },
    {
      "key": "grok",
      "label": "Grok",
      "short_label": "Grok",
      "format_val": "{{grok_display}}",
      "unit": "",
      "color": "{{grok_color}}"
    },
    {
      "key": "gemini",
      "label": "Gemini",
      "short_label": "Gemini",
      "format_val": "{{gemini_display}}",
      "unit": "",
      "color": "{{gemini_color}}"
    },
    {
      "key": "opencode",
      "label": "OpenCode",
      "short_label": "OpenCode",
      "format_val": "{{opencode_display}}",
      "unit": "",
      "color": "{{opencode_color}}"
    }
  ]
}
